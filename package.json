{
  "name": "loompad",
  "version": "0.1.0",
  "private": true,
  "description": "A programmable launch layer for Solana.",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "npm@11.17.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @loompad/reference-app",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "security:check": "node scripts/repository-check.mjs && npm audit --audit-level=moderate",
    "test": "vitest run --coverage --configLoader runner",
    "typecheck": "tsc -b --pretty false",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run security:check",
    "clean": "node scripts/clean.mjs",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1",
    "vitest": "5.0.1"
  }
}
